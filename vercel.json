{
 "rewrites": [
  {
   "source": "/admin",
   "destination": "/api/admin"
  }
 ],
 "headers": [
  {
   "source": "/media/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ]
}